UPLOAD_DIR=uploads
# 巨量千川应用密钥（config.py 从环境变量读取，必填）
QIANCHUAN_SECRET=
# New API 渠道模型查询与调用渠道审计所需；管理访问令牌不是生图 API Key
NEWAPI_ADMIN_ACCESS_TOKEN=

# --- LLM 网关（统一走 new-api 中转） ---
NEWAPI_BASE_URL=http://192.168.110.254/v1
NEWAPI_API_KEY=

# 生图限流：并发限制在每个服务进程内共享；多进程配额需同时在网关侧限制。
NODE4_GEN_CONCURRENCY=2
IMAGE_REQUEST_CONCURRENCY=2
IMAGE_REQUEST_INTERVAL=1
IMAGE_RATE_LIMIT_RETRIES=1
# 累计排队/限流等待上限，不包含模型生成时间。
IMAGE_RETRY_DEADLINE=600
# 每次实际生图调用独立计时：5 分钟，不包含排队、限流等待及其他模型尝试。
IMAGE_TIMEOUT=300

# 新增公司用户使用的初始密码（默认 sy123456，最多 72 UTF-8 字节）
AUTH_INITIAL_PASSWORD=sy123456
# HTTPS 生产环境必须为 true；本地 HTTP 调试媒体预览可设置 false
AUTH_COOKIE_SECURE=true
